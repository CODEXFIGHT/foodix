<?php
/**
 * RestaurOS — Plantilla de secretos locales del backend PHP.
 *
 * Copia este archivo a `secrets.local.php` (sin ".example") y llena los
 * valores reales. `secrets.local.php` está en .gitignore — nunca se sube a
 * git, solo se coloca directo en el servidor por FTP/SSH.
 *
 * @package RestaurOS
 */
declare(strict_types=1);

// Key de https://openrouter.ai/keys — usada por /ordenes/parse-voz (comanda
// por voz del mesero). Sin esta key, ese endpoint sigue funcionando pero
// siempre degrada a confianza 0 (ver php-backend/routes/ordenes.php).
define('OPENROUTER_API_KEY', 'sk-or-v1-reemplaza-esto-con-tu-key-real');

// ─────────────────────────────────────────────────────────────────────────────
// Alta autoservicio + prueba gratuita de 14 días
// ─────────────────────────────────────────────────────────────────────────────

// Pepper del hashing de identidades antiabuso (correo/teléfono/dispositivo/IP).
// Genera uno con: php -r "echo bin2hex(random_bytes(32));"
// ⚠️ Si lo cambias, el historial de trials existente deja de coincidir: fíjalo
// UNA vez y no lo toques. Si se omite, se deriva de JWT_SECRET.
define('TRIAL_HASH_SECRET', 'reemplaza-esto-con-64-hex-aleatorios');

// URL pública del front (se usa en los enlaces de los correos).
define('APP_PUBLIC_URL', 'https://restauros.app');

// ── Correo transaccional por SMTP (verificación de cuenta y avisos) ──────────
// Usa una cuenta de correo del propio dominio (la que incluye el hosting).
// Sin esto se usa mail() de PHP, que en hosting compartido suele caer en spam.
define('SMTP_HOST',   'mail.tudominio.mx');
define('SMTP_PORT',   587);          // 587 = STARTTLS · 465 = SSL
define('SMTP_SECURE', 'tls');        // 'tls' | 'ssl' | ''
define('SMTP_USER',   'no-reply@tudominio.mx');
define('SMTP_PASS',   'la-contrasena-del-buzon');
define('SMTP_FROM',   'no-reply@tudominio.mx');

// ── Código de verificación (OTP) ────────────────────────────────────────────
// El código de 6 dígitos se envía SIEMPRE por correo, usando el mismo SMTP de
// arriba. No hay SMS ni WhatsApp en el alta: nada más que configurar aquí.

// Buzón de soporte que se muestra en los correos (opcional).
// define('SUPPORT_EMAIL', 'soporte@tudominio.mx');
